{
	"name": "rtp.js",
	"version": "1.0.0",
	"description": "RTP stack for Node.js and browser written in TypeScript",
	"author": "Iñaki Baz Castillo <ibc@aliax.net> (https://inakibaz.me)",
	"homepage": "https://github.com/versatica/rtp.js",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versatica/rtp.js.git"
	},
	"exports": {
		"./packets/common": {
			"typedoc": "./src/packets/common/public.ts",
			"types": "./lib/packets/common/public.d.ts",
			"default": "./lib/packets/common/public.js"
		},
		"./packets/RTP": {
			"typedoc": "./src/packets/RTP/public.ts",
			"types": "./lib/packets/RTP/public.d.ts",
			"default": "./lib/packets/RTP/public.js"
		},
		"./packets/RTCP": {
			"typedoc": "./src/packets/RTCP/public.ts",
			"types": "./lib/packets/RTCP/public.d.ts",
			"default": "./lib/packets/RTCP/public.js"
		},
		"./utils": {
			"typedoc": "./src/utils/public.ts",
			"types": "./lib/utils/public.d.ts",
			"default": "./lib/utils/public.js"
		}
	},
	"files": [
		"LICENSE",
		"README.md",
		"npm-scripts.mjs",
		"lib"
	],
	"keywords": [
		"rtp",
		"rtcp",
		"webrtc",
		"nodejs"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "node npm-scripts.mjs prepare",
		"prepublishOnly": "node npm-scripts.mjs prepublishOnly",
		"typescript:build": "node npm-scripts.mjs typescript:build",
		"typescript:watch": "node npm-scripts.mjs typescript:watch",
		"lint": "node npm-scripts.mjs lint",
		"format": "node npm-scripts.mjs format",
		"test": "node npm-scripts.mjs test",
		"coverage": "node npm-scripts.mjs coverage",
		"publish:dry-run": "node npm-scripts.mjs publish:dry-run",
		"release:check": "node npm-scripts.mjs release:check",
		"release": "node npm-scripts.mjs release",
		"docs": "node npm-scripts.mjs docs",
		"docs:watch": "node npm-scripts.mjs docs:watch",
		"docs:check": "node npm-scripts.mjs docs:check"
	},
	"dependencies": {
		"@types/events-alias": "npm:@types/events@^3.0.3",
		"debug": "^4.4.3",
		"events": "^3.3.0",
		"supports-color": "^11.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/debug": "^4.1.13",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.10",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.17.1",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"knip": "^6.48.0",
		"open-cli": "^9.0.0",
		"prettier": "^3.10.1",
		"ts-jest": "^29.4.15",
		"typedoc": "^0.28.20",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0"
	}
}
